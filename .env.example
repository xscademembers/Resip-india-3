# ============================================================
# ReSip India — Environment Variables
# ============================================================
# Copy this file to .env and fill in every value.
# DO NOT commit your .env file to version control.
# ============================================================

# ---------- General ----------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000

# ---------- MongoDB Atlas ----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resip-india?retryWrites=true&w=majority

# ---------- JWT ----------
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ---------- Cloudinary (Image Uploads) — OPTIONAL ----------
# Only needed if you want admins to upload image FILES from their computer via
# the admin panel. If you host images elsewhere (e.g. Wix / wixstatic.com) and
# just paste image URLs into the product form, you can leave these blank.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- PhonePe Payment Gateway ----------
PHONEPE_MERCHANT_ID=your_merchant_id
PHONEPE_SALT_KEY=your_salt_key
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT
# UAT  → https://api-preprod.phonepe.com/apis/pg-sandbox
# PROD → https://api.phonepe.com/apis/hermes

# ---------- Email (SMTP — works with Gmail, SendGrid, AWS SES, etc.) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="ReSip India <noreply@resipindia.com>"

# ---------- Admin Seed ----------
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@resipindia.com
ADMIN_PASSWORD=Admin@123456

# ---------- Gemini AI (existing) ----------
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ---------- App URL (existing) ----------
APP_URL=MY_APP_URL
