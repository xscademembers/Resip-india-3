# ============================================================
# ReSip India — Environment Variables (example)
# ============================================================
# Copy this file to .env.local (or .env) and fill in every value.
# DO NOT commit files that contain real secrets.
# ============================================================

# ---------- General ----------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5000
API_URL=http://localhost:5000
# Public URL used for payment return/webhook links (production domain).
PUBLIC_URL=http://localhost:5000

# ---------- Frontend (Vite) ----------
# Optional — override API base URL when frontend and backend are on different domains.
VITE_API_URL=

# ---------- MongoDB Atlas ----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ---------- JWT ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@example.com
SMTP_PASS=your-smtp-password
EMAIL_FROM="ReSip India <hello@example.com>"
CONTACT_EMAIL=hello@example.com

# ---------- Brevo HTTP API ----------
# v3 API key (starts with xkeysib-), NOT the SMTP key (xsmtpsib-).
BREVO_API_KEY=xkeysib-your-brevo-api-key

# ---------- Cashfree Payment Gateway ----------
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
# SANDBOX for testing, PRODUCTION when live.
CASHFREE_ENV=SANDBOX

# ---------- Delhivery Shipping ----------
# API token from Delhivery One → Settings → API Token Generation.
DELHIVERY_API_TOKEN=your-delhivery-api-token
# Warehouse name(s) from Delhivery One → Pickup Locations (case-sensitive).
# For multiple locations, comma-separate them — first one is the default.
DELHIVERY_PICKUP_LOCATION=ReSip India,Raunak Patle
# STAGING for testing, PRODUCTION when live.
DELHIVERY_ENV=STAGING

# ---------- Admin Seed (used by server/seed.js) ----------
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@resipindia.com
ADMIN_PASSWORD=change-me
